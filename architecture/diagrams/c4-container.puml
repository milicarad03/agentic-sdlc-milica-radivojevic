@startuml c4-container
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

left to right direction
skinparam ranksep 160
skinparam nodesep 60

title Container diagram for Mars Rover System

Person(user, "User", "Defines the scenario and submits commands")

System_Boundary(system_boundary, "Mars Rover System") {
    Container(cli, "Mars Rover CLI", "Python", "Accepts initial position, orientation, obstacle map, and command sequence. Processes commands and returns the resulting rover position and orientation.")
}

Rel(user, cli, "Submits start position, map and commands", "CLI")
Rel(cli, user, "Returns final position and direction", "CLI")

SHOW_LEGEND()

@enduml
